{
  "name": "mahakalyanam-wedding",
  "version": "1.0.0",
  "description": "MaHaKalyanam Wedding Invitation — Ranjith & Nithaya",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"yellow,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "vercel-build": "cd client && npx vite build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
